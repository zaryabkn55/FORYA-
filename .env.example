# FORYA — environment contract.
#
# Copy to .env for local work. In production these are set in the host's dashboard, never
# committed. backend/src/env.ts validates all of this at boot: a production start with
# anything required missing fails immediately rather than half-working in public.

# ── required in production ────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000

# Postgres. Railway and Render inject this for you when you attach their database.
DATABASE_URL="postgresql://forya:password@localhost:5432/foryadb?schema=public"

# Signs session tokens. At least 32 characters, random, and never reused between
# environments — rotating it signs every user out, which is exactly what you want if it leaks.
#   openssl rand -base64 48
JWT_SECRET=""

# Exact origin(s) the web app is served from, comma-separated, including the scheme.
# The app serves its own frontend, so normally this is just its own public URL.
#   ALLOWED_ORIGINS=https://forya.up.railway.app
ALLOWED_ORIGINS=""

# Number of reverse proxies in front of the app. 1 on Railway/Render/Fly; 0 when running
# the container directly. Wrong value means rate limiting counts everyone as one visitor.
TRUST_PROXY_HOPS=1

# ── operator access ───────────────────────────────────────────────────────────

# Guards /api/products/sync-all-brands and /api/products/ingest-live, which spend scraping
# credits and hit retailers' sites. Leave empty and those routes stay closed (503).
#   openssl rand -hex 32
ADMIN_TOKEN=""

# ── the AI stylist (optional) ─────────────────────────────────────────────────

# Leave empty to run on the on-device stylist only — free, offline, no account needed.
# Set it and signed-in users get Claude, inside the budgets below.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_MODEL_QUICK="claude-haiku-5-5"

# Spend ceilings. Per-user per rolling hour, and whole-server per UTC day.
# When the daily cap is reached the app falls back to the on-device stylist until midnight.
AI_USER_HOURLY_CALLS=40
AI_DAILY_CALLS=2000
AI_MAX_OUTPUT_TOKENS=1200

# ── optional ──────────────────────────────────────────────────────────────────

# Restrict the retailer image proxy to specific hosts, comma-separated. Empty means any
# public host is allowed (private and link-local addresses are always refused).
IMAGE_PROXY_ALLOWED_HOSTS=""

# Catalogue scraping, only needed when running the ingest routes.
SCRAPINGBEE_API_KEY=""
SCRAPINGBEE_MAX_TIER=premium-js
SCRAPINGBEE_COUNTRY=gb
