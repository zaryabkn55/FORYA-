# Copy to backend/.env for `npm run dev` outside Docker.
DATABASE_URL="postgresql://forya:foryasecret@localhost:5432/foryadb?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
# FORYA AI (stylist chat, "Style it for me", look feedback). Leave empty to use the on-device stylist only.
ANTHROPIC_API_KEY=""
# Optional overrides
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_MODEL_QUICK="claude-haiku-5-5"
